; Generated by skeleton-converter: minimal web-preview wrapper. The converted
; scene (hero.tscn) is loaded at runtime by main.gd; this project exists only
; so Godot can export a playable web build around it.
config_version=5

[application]

config/name="skeleton-converter preview"
run/main_scene="res://boot.tscn"
config/features=PackedStringArray("4.7")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
